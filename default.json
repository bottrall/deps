{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for bottrall's repos. Extend with \"github>bottrall/deps\".",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "America/Vancouver",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"],
    "automerge": true,
    "automergeType": "pr",
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gem dependencies declared in gemspecs, which the bundler manager doesn't read",
      "managerFilePatterns": ["/\\.gemspec$/"],
      "matchStrings": [
        "\\.add_(?:runtime_|development_)?dependency\\s*\\(?\\s*['\"](?<depName>[^'\"]+)['\"]\\s*,\\s*['\"](?<currentValue>[^'\"]+)['\"]"
      ],
      "datasourceTemplate": "rubygems",
      "versioningTemplate": "hex"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for every non-major update, merged automatically once the repo's required checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Majors get their own PRs and are never merged automatically",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major"],
      "automerge": false
    },
    {
      "description": "A new gemspec constraint stales the PATH section of Gemfile.lock, which frozen installs in CI reject, so regenerate it in the same commit",
      "matchFileNames": ["**/*.gemspec"],
      "postUpgradeTasks": {
        "commands": ["bundle lock --update {{{depName}}}"],
        "workingDirTemplate": "{{{packageFileDir}}}",
        "fileFilters": ["**/Gemfile.lock"],
        "installTools": { "ruby": {}, "bundler": {} }
      }
    }
  ]
}
